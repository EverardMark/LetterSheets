{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "session_hours": 24,
    "max_login_attempts": 5,
    "lockout_minutes": 30,
    "allowed_origins": ["http://localhost:5173"],
    "tls_cert_file": "",
    "tls_key_file": "",
    "tls_port": 0,
    "trust_proxy_headers": false
  },
  "database": {
    "host": "localhost",
    "port": 3306,
    "user": "REPLACE_WITH_DB_USER",
    "password": "REPLACE_WITH_DB_PASSWORD",
    "db_name": "lettersheets",
    "max_open": 25,
    "max_idle": 5,
    "max_life_minutes": 5
  },
  "smtp": {
    "_comment": "Outbound email is OFF until enabled is true. While off, queued messages stay Pending and are visible in Settings > Email queue; nothing is sent.",
    "enabled": false,
    "host": "smtp.example.com",
    "port": 587,
    "username": "REPLACE_WITH_SMTP_USER",
    "password": "REPLACE_WITH_SMTP_PASSWORD",
    "from_email": "no-reply@example.com",
    "from_name": "LetterSheets ERP",
    "implicit_tls": false,
    "skip_verify": false,
    "worker_seconds": 60,
    "batch_size": 20
  },
  "ai": {
    "_comment": "The prompt assistant is OFF until enabled is true AND base_url + base_model are set. base_url is ONE OpenAI-compatible inference server (vLLM with --enable-lora, Ollama, llama.cpp); per-company LoRA adapters are selected per request from the ai_company_adapters table, falling back to base_model for companies that do not have one yet.",
    "enabled": false,
    "base_url": "http://127.0.0.1:8000",
    "base_model": "qwen3-14b",
    "api_key": "",
    "_vision_comment": "Reads scanned receipts and invoices. A SEPARATE vision-language model from base_model — folding vision into the tool-calling adapter would make every tenant carry vision weights whether or not they scan anything. Empty disables scanning.",
    "vision_base_url": "http://127.0.0.1:8002",
    "vision_model": "",
    "timeout_seconds": 180
  }
}
