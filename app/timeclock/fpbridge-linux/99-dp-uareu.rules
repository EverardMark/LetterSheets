# DigitalPersona / HID U.are.U fingerprint readers.
# Grants the locally-logged-in (seat) user access to the reader so the kiosk
# can run fpbridge without root. Vendor 0x05ba = DigitalPersona/HID Global
# (covers U.are.U 4000/4500/5100/5160/5300).
#
# Install:
#   sudo cp 99-dp-uareu.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then unplug/replug the reader.

# Primary (Pi kiosk): fpbridge runs as a system service (User=biometrics), which
# is not guaranteed to be the active seat, so grant access via a group. Create it
# and add the service user once:
#   sudo groupadd -f plugdev && sudo usermod -aG plugdev biometrics
SUBSYSTEM=="usb", ATTR{idVendor}=="05ba", MODE="0660", GROUP="plugdev"

# Alternative: if fpbridge runs as the active seat/login user instead, drop the
# GROUP line above and use uaccess (grants the ACL to whoever is logged in):
# SUBSYSTEM=="usb", ATTR{idVendor}=="05ba", MODE="0660", TAG+="uaccess"
