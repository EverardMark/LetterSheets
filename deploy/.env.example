# Copy to the repo root as `.env` (git-ignored) and fill in real values.
#   cp deploy/.env.example .env

# Public domain that resolves to this server (required for automatic TLS).
LS_DOMAIN=erp.example.com

# Database. Use strong, UNIQUE passwords — these are NOT the ones from the old
# committed config.json (which are compromised and must be rotated).
LS_DB_NAME=lettersheets
LS_DB_USER=lettersheets
LS_DB_PASSWORD=change_me_strong_db_password
MYSQL_ROOT_PASSWORD=change_me_different_strong_root_password

# CORS allowlist for the API. The Electron client uses bearer-token auth (not
# cookies), so CORS is not a security boundary here — leaving this empty is fine.
# Set it (comma-separated origins) only if you also serve a browser web build.
LS_ALLOWED_ORIGINS=
